generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARENT
  ORGANIZER
  ADMIN
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELLED
}

enum AtBatResult {
  SINGLE
  DOUBLE
  TRIPLE
  HOME_RUN
  OUT
  ERROR
  WALK
  HIT_BY_PITCH
  SACRIFICE
  FIELDERS_CHOICE
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  firstName           String
  lastName            String
  role                Role                 @default(PARENT)
  status              RegistrationStatus   @default(PENDING)
  canCompare          Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  players             Player[]
  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  matchEdits          MatchEditor[]
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("password_reset_tokens")
}

model Team {
  id              String       @id @default(cuid())
  name            String
  shortName       String?
  logoUrl         String?
  primaryColor    String       @default("#1e3a5f")
  secondaryColor  String       @default("#7dd3fc")
  backgroundColor String       @default("#f0f9ff")
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  players         PlayerTeam[]
  homeMatches     Match[]      @relation("HomeTeam")
  awayMatches     Match[]      @relation("AwayTeam")
  seasons         Season[]
  @@map("teams")
}

model Season {
  id        String       @id @default(cuid())
  name      String
  year      Int
  isActive  Boolean      @default(true)
  teamId    String?
  team      Team?        @relation(fields: [teamId], references: [id])
  createdAt DateTime     @default(now())
  players   PlayerTeam[]
  matches   Match[]
  @@map("seasons")
}

model Player {
  id           String            @id @default(cuid())
  firstName    String
  lastName     String
  jerseyNumber Int?
  photoUrl     String?
  birthYear    Int?
  category     String?
  parentId     String?
  parent       User?             @relation(fields: [parentId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  teams        PlayerTeam[]
  stats        PlayerMatchStat[]
  positions    PlayerPosition[]
  @@map("players")
}

model PlayerTeam {
  id        String   @id @default(cuid())
  playerId  String
  teamId    String
  seasonId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season    Season?  @relation(fields: [seasonId], references: [id])
  @@unique([playerId, teamId, seasonId])
  @@map("player_teams")
}

model Match {
  id           String            @id @default(cuid())
  date         DateTime
  time         String?
  location     String?
  homeTeamId   String
  awayTeamId   String?
  awayTeamName String?
  homeScore    Int               @default(0)
  awayScore    Int               @default(0)
  status       MatchStatus       @default(SCHEDULED)
  seasonId     String?
  isHome       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  homeTeam     Team              @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam     Team?             @relation("AwayTeam", fields: [awayTeamId], references: [id])
  season       Season?           @relation(fields: [seasonId], references: [id])
  innings      Inning[]
  playerStats  PlayerMatchStat[]
  editors      MatchEditor[]
  lineups      Lineup[]
  @@map("matches")
}

model MatchEditor {
  id       String   @id @default(cuid())
  matchId  String
  userId   String
  teamId   String?
  lockedAt DateTime @default(now())
  isActive Boolean  @default(true)
  match    Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([matchId, userId])
  @@map("match_editors")
}

model Inning {
  id               String            @id @default(cuid())
  matchId          String
  number           Int
  isTop            Boolean
  homeRuns         Int               @default(0)
  awayRuns         Int               @default(0)
  createdAt        DateTime          @default(now())
  match            Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  plateAppearances PlateAppearance[]
  @@unique([matchId, number, isTop])
  @@map("innings")
}

model Lineup {
  id           String   @id @default(cuid())
  matchId      String
  teamId       String
  playerId     String
  battingOrder Int?
  position     String?
  createdAt    DateTime @default(now())
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  @@unique([matchId, teamId, playerId])
  @@map("lineups")
}

model PlateAppearance {
  id           String       @id @default(cuid())
  inningId     String
  playerId     String
  battingOrder Int?
  result       AtBatResult?
  basesReached Int?
  balls        Int?
  strikes      Int?
  isAtBat      Boolean      @default(true)
  runsScored   Int          @default(0)
  rbi          Int          @default(0)
  createdAt    DateTime     @default(now())
  inning       Inning       @relation(fields: [inningId], references: [id], onDelete: Cascade)
  @@map("plate_appearances")
}

model PlayerMatchStat {
  id                String   @id @default(cuid())
  matchId           String
  playerId          String
  teamId            String?
  atBats            Int      @default(0)
  hits              Int      @default(0)
  singles           Int      @default(0)
  doubles           Int      @default(0)
  triples           Int      @default(0)
  homeRuns          Int      @default(0)
  runs              Int      @default(0)
  rbi               Int      @default(0)
  walks             Int      @default(0)
  strikeouts        Int      @default(0)
  reachedOnError    Int      @default(0)
  errors            Int      @default(0)
  putouts           Int      @default(0)
  assists           Int      @default(0)
  inningsInField    Float    @default(0)
  inningsPitched    Float    @default(0)
  hitsAllowed       Int      @default(0)
  runsAllowed       Int      @default(0)
  earnedRuns        Int      @default(0)
  walksAllowed      Int      @default(0)
  strikeoutsPitched Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  match             Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player            Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@unique([matchId, playerId])
  @@map("player_match_stats")
}

model PlayerPosition {
  id        String   @id @default(cuid())
  playerId  String
  matchId   String?
  position  String
  innings   Float    @default(0)
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@map("player_positions")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
  @@map("system_settings")
}
