# Databáze (PostgreSQL)
DATABASE_URL="postgresql://baseball:baseball@localhost:5432/baseball_app?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="zmen-tento-tajny-klic-na-nahodny-retezec"

# Setup/bootstrap (povinné pro /api/setup-admin a /api/setup-seed)
# Bez SETUP_SECRET jsou tyto endpointy vypnuté (403).
SETUP_SECRET="nahodny-dlouhy-tajny-retezec"
# Volitelné výchozí heslo admina při setup-admin
# ADMIN_INITIAL_PASSWORD=""

# SMTP (pro e-maily)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@baseball-app.cz"
